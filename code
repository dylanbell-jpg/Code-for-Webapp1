/***************************************************************
 * AUTO ACTIONS
 ***************************************************************/
function onEdit(e) {
  if (!e) return;

  const sheet = e.range.getSheet();
  const sheetName = sheet.getName();
  const a1 = e.range.getA1Notation();

  // CREATE REVISION
  if (
    sheetName === 'Archive Search' &&
    a1 === 'J2' &&
    e.value === 'TRUE'
  ) {
    try {
      createRevisionFromArchiveSearch();
    } catch (err) {
      SpreadsheetApp.getUi().alert(
        'Could not create revision:\n\n' +
        err.message
      );
    } finally {
      sheet.getRange('J2').setValue(false);
    }

    return;
  }

  if (sheetName !== CONFIG.QUOTE_SHEET) return;

  // CUSTOMER SELECTED
  if (a1 === CONFIG.CUSTOMER_CELL) {
    autoFillCustomer(sheet);
    return;
  }

  // ATTENTION / CONTACT SELECTED
  if (a1 === CONFIG.ATTENTION_CELL) {
    autoFillCustomerContact(sheet);
    return;
  }

  // ITEM OR PART NUMBER EDITED
  const row = e.range.getRow();
  const col = e.range.getColumn();

  if (
    row >= CONFIG.ITEM_START_ROW &&
    row <= CONFIG.ITEM_END_ROW &&
    (col === 2 || col === 3)
  ) {
    autoFillItemRow(sheet, row, col);
  }
}

/***************************************************************
 * QUOTE NUMBER
 *
 * Format:
 * YYYYMMDD + sequence
 *
 * Example:
 * 202610011
 * 202610012
 *
 * Revisions:
 * 202610011-2
 * 202610011-3
 ***************************************************************/
function generateQuoteNumber() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const quoteSheet = ss.getSheetByName(CONFIG.QUOTE_SHEET);

  const current = String(
    quoteSheet.getRange(CONFIG.QUOTE_NUMBER_CELL).getDisplayValue()
  ).trim();

  if (current) return current;

  const preparedBy = String(
    quoteSheet.getRange(CONFIG.PREPARED_BY_CELL).getDisplayValue()
  ).trim();

  if (!preparedBy) {
    throw new Error('Prepared By is blank.');
  }

  const masterSS = SpreadsheetApp.openById(
    CONFIG.MASTER_SPREADSHEET_ID
  );

  const lists = masterSS.getSheetByName(CONFIG.LISTS_SHEET);

  if (!lists) {
    throw new Error('Lists sheet was not found.');
  }

  const lastRow = lists.getLastRow();

  const salespeople = lists
    .getRange(2, 3, lastRow - 1, 2)
    .getDisplayValues();

  let salespersonSlot = '';

  for (let i = 0; i < salespeople.length; i++) {
    const name = String(salespeople[i][0]).trim();
    const slot = String(salespeople[i][1]).trim();

    if (
      name.toLowerCase() === preparedBy.toLowerCase()
    ) {
      salespersonSlot = slot;
      break;
    }
  }

  if (!salespersonSlot) {
    throw new Error(
      'No Salesperson Slot was found for ' + preparedBy + '.'
    );
  }

  const tz = ss.getSpreadsheetTimeZone();
  const year = Utilities.formatDate(new Date(), tz, 'yy');

  const prefix = salespersonSlot + '-' + year + '-';

  let highestSequence = 0;

  [CONFIG.SALES_ARCHIVE, CONFIG.SERVICE_ARCHIVE].forEach(
    function(sheetName) {
      const archive = ss.getSheetByName(sheetName);

      if (!archive || archive.getLastRow() < 2) return;

      const values = archive
        .getRange(2, 2, archive.getLastRow() - 1, 1)
        .getDisplayValues();

      values.forEach(function(row) {
        const quoteNum = String(row[0]).trim();

        if (!quoteNum) return;
        if (quoteNum.indexOf(prefix) !== 0) return;

        const parts = quoteNum.split('-');

        if (parts.length < 3) return;

        const sequence = parseInt(parts[2], 10);

        if (!isNaN(sequence) && sequence > highestSequence) {
          highestSequence = sequence;
        }
      });
    }
  );

  const nextSequence = String(highestSequence + 1)
    .padStart(4, '0');

  const quoteNumber =
    salespersonSlot +
    '-' +
    year +
    '-' +
    nextSequence;

  quoteSheet
    .getRange(CONFIG.QUOTE_NUMBER_CELL)
    .setValue(quoteNumber);

  if (!quoteSheet.getRange(CONFIG.DATE_CELL).getValue()) {
    quoteSheet
      .getRange(CONFIG.DATE_CELL)
      .setValue(new Date());
  }

  SpreadsheetApp.flush();

  return quoteNumber;
}
