}
function autoFillItemRow(
  quoteSheet,
  rowNumber,
  editedColumn
) {
  const item = String(
    quoteSheet
      .getRange(rowNumber, 2)
      .getDisplayValue()
  ).trim();

  const partNumber = String(
    quoteSheet
      .getRange(rowNumber, 3)
      .getDisplayValue()
  ).trim();

  if (!item && !partNumber) return;

  const masterSS = SpreadsheetApp.openById(
    CONFIG.MASTER_SPREADSHEET_ID
  );

  const db = masterSS.getSheetByName(
    'Item Database'
  );

  if (!db || db.getLastRow() < 4) return;

  const rows = db
    .getRange(
      4,
      1,
      db.getLastRow() - 3,
      5
    )
    .getValues();

  let match = null;

  for (let i = 0; i < rows.length; i++) {
    const dbItem =
      String(rows[i][0] || '')
        .trim()
        .toLowerCase();

    const dbPart =
      String(rows[i][1] || '')
        .trim()
        .toLowerCase();

    if (
      editedColumn === 3 &&
      partNumber &&
      dbPart === partNumber.toLowerCase()
    ) {
      match = rows[i];
      break;
    }

    if (
      editedColumn === 2 &&
      item &&
      dbItem === item.toLowerCase()
    ) {
      match = rows[i];
      break;
    }
  }

  if (!match) return;

  // A Qty stays untouched

  quoteSheet
    .getRange(rowNumber, 2)
    .setValue(match[0]);

  quoteSheet
    .getRange(rowNumber, 3)
    .setValue(match[1]);

  quoteSheet
    .getRange(rowNumber, 4)
    .setValue(match[2]);

  quoteSheet
    .getRange(rowNumber, 5)
    .setValue(match[3]);

  quoteSheet
    .getRange(rowNumber, 6)
    .setValue(match[4]);
}
