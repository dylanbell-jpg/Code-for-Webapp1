/***************************************************************
 * CUSTOMER DATABASE
 ***************************************************************/
function saveItemToDatabase(
  item,
  partNumber,
  customerCost,
  ourCost,
  category
) {
  if (!item) return;

  const masterSS = SpreadsheetApp.openById(
    CONFIG.MASTER_SPREADSHEET_ID
  );

  const db = masterSS.getSheetByName('Item Database');

  if (!db) {
    throw new Error('Item Database sheet was not found.');
  }

  const lastRow = db.getLastRow();
  let existingRow = 0;

  if (lastRow >= 4) {
    const existingItems = db
      .getRange(4, 1, lastRow - 3, 2)
      .getDisplayValues();

    for (let i = 0; i < existingItems.length; i++) {
      const dbItem = String(existingItems[i][0]).trim();
      const dbPart = String(existingItems[i][1]).trim();

      const partMatches =
        partNumber &&
        dbPart.toLowerCase() ===
          String(partNumber).trim().toLowerCase();

      const itemMatches =
        !partNumber &&
        dbItem.toLowerCase() ===
          String(item).trim().toLowerCase();

      if (partMatches || itemMatches) {
        existingRow = i + 4;
        break;
      }
    }
  }

 const rowData = [[
  item,
  partNumber,
  category,
  customerCost,
  ourCost
]];

  if (existingRow) {
    db.getRange(existingRow, 1, 1, 5).setValues(rowData);
  } else {
    db.getRange(db.getLastRow() + 1, 1, 1, 5)
      .setValues(rowData);
  }
}
function saveQuoteItemsToDatabase(quoteSheet) {
  const rowCount =
    CONFIG.ITEM_END_ROW -
    CONFIG.ITEM_START_ROW +
    1;

  const rows = quoteSheet
    .getRange(
      CONFIG.ITEM_START_ROW,
      1,
      rowCount,
      8
    )
    .getValues();

  rows.forEach(function(row, index) {
    const item = String(row[1] || '').trim();
    const partNumber = String(row[2] || '').trim();
    const category = String(row[3] || '').trim();
    const customerCost = row[4];
    const ourCost = row[5];

    if (!item) return;

    if (!category) {
      throw new Error(
        'Select a Category for item "' +
        item +
        '" on row ' +
        (CONFIG.ITEM_START_ROW + index) +
        '.'
      );
    }

    saveItemToDatabase(
      item,
      partNumber,
      customerCost,
      ourCost,
      category
    );
  });

  sortItemDatabaseByCategory();
}


function sortItemDatabaseByCategory() {
  const masterSS = SpreadsheetApp.openById(
    CONFIG.MASTER_SPREADSHEET_ID
  );

  const db = masterSS.getSheetByName('Item Database');
  const lists = masterSS.getSheetByName('Lists');

  if (!db || !lists) return;

  const lastDbRow = db.getLastRow();

  if (lastDbRow < 5) return;

  const lastListRow = lists.getLastRow();

  const categories = lists
    .getRange(2, 12, lastListRow - 1, 1)
    .getDisplayValues()
    .flat()
    .map(function(value) {
      return String(value).trim();
    })
    .filter(function(value) {
      return value !== '';
    });

  const categoryOrder = {};

  categories.forEach(function(category, index) {
    categoryOrder[category.toLowerCase()] = index;
  });

  const range = db.getRange(
    4,
    1,
    lastDbRow - 3,
    5
  );

  const values = range.getValues();

  values.sort(function(a, b) {
    const categoryA =
      String(a[4] || '').trim().toLowerCase();

    const categoryB =
      String(b[4] || '').trim().toLowerCase();

    const orderA =
      categoryOrder[categoryA] !== undefined
        ? categoryOrder[categoryA]
        : 9999;

    const orderB =
      categoryOrder[categoryB] !== undefined
        ? categoryOrder[categoryB]
        : 9999;

    if (orderA !== orderB) {
      return orderA - orderB;
    }

    return String(a[0] || '')
      .localeCompare(String(b[0] || ''));
  });

  range.setValues(values);
}

/***************************************************************
 * LOAD CUSTOMER INFO
 ***************************************************************/
function loadCustomerInformation() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const quoteSheet = ss.getSheetByName(CONFIG.QUOTE_SHEET);
  const db = ss.getSheetByName(CONFIG.CUSTOMER_DB);

  if (!quoteSheet || !db) return;

  const customer = String(
    quoteSheet.getRange(CONFIG.CUSTOMER_CELL).getDisplayValue()
  ).trim();

  if (!customer) {
    quoteSheet.getRange(CONFIG.ATTENTION_CELL).clearContent();
    quoteSheet.getRange(CONFIG.PHONE_CELL).clearContent();
    quoteSheet.getRange(CONFIG.EMAIL_CELL).clearContent();
    return;
  }

  const lastRow = db.getLastRow();

  if (lastRow < 2) return;

  const data = db
    .getRange(2, 1, lastRow - 1, 4)
    .getDisplayValues();

  for (let i = 0; i < data.length; i++) {
    const dbCustomer = String(data[i][0]).trim();

    if (
      dbCustomer.toLowerCase() === customer.toLowerCase()
    ) {
      quoteSheet
        .getRange(CONFIG.ATTENTION_CELL)
        .setValue(data[i][1]);

      quoteSheet
        .getRange(CONFIG.PHONE_CELL)
        .setValue(data[i][2]);

      quoteSheet
        .getRange(CONFIG.EMAIL_CELL)
        .setValue(data[i][3]);

      return;
    }
  }
}


/***************************************************************
 * FIND SALESPERSON'S QUOTES FOLDER
 *
 * Lists sheet:
 * C = Prepared By
 * G = Quotes Folder ID
 ***************************************************************/
function getSalespersonQuoteFolder(preparedBy) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const lists = ss.getSheetByName(CONFIG.LISTS_SHEET);

  if (!lists) return null;

  const lastRow = lists.getLastRow();

  if (lastRow < 2) return null;

  const data = lists
    .getRange(2, 3, lastRow - 1, 5)
    .getDisplayValues();

  for (let i = 0; i < data.length; i++) {
    const salesperson = String(data[i][0]).trim();

    // Column G relative to C:G = index 4
    const quotesFolderId = String(data[i][4]).trim();

    if (
      salesperson.toLowerCase() ===
      preparedBy.toLowerCase()
    ) {
      return quotesFolderId;
    }
  }

  return null;
}
function createEditableQuoteCopy(preparedBy, customer, quoteNumber) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const editableFolderId =
    getSalespersonEditableQuoteFolder(preparedBy);

  if (!editableFolderId) {
    throw new Error(
      'No Editable Quotes Folder ID was found for ' + preparedBy + '.'
    );
  }

  const editableFolder =
    DriveApp.getFolderById(editableFolderId);

  // If this file is already inside the Editable Quotes folder,
  // do NOT create another editable copy.
  const currentFile = DriveApp.getFileById(ss.getId());
  const parents = currentFile.getParents();

  while (parents.hasNext()) {
    if (parents.next().getId() === editableFolderId) {
      return null;
    }
  }

  const safeCustomer = String(customer)
    .replace(/[\\/:*?"<>|]/g, '')
    .trim();

  const editableName =
    safeCustomer +
    ' - Quote ' +
    quoteNumber +
    ' - EDITABLE';

  // Copy the entire working quote workbook
  const copiedFile =
    currentFile.makeCopy(editableName, editableFolder);

  const copiedSS =
    SpreadsheetApp.openById(copiedFile.getId());

  /*
   * Freeze the Lists data inside the archived copy.
   * This is important for salesperson copies that use IMPORTRANGE.
   */
  const copiedLists =
    copiedSS.getSheetByName(CONFIG.LISTS_SHEET);

  if (copiedLists) {
    const lastRow = copiedLists.getLastRow();

    if (lastRow > 0) {
      const listRange =
        copiedLists.getRange(1, 3, lastRow, 6);

      const listValues =
        listRange.getDisplayValues();

      listRange.clearContent();
      listRange.setValues(listValues);
    }
  }

  /*
   * Only Quote and Customer Quote remain visible.
   * Everything else stays in the file so formulas/scripts continue working.
   */
  copiedSS.getSheets().forEach(function(sheet) {
    const name = sheet.getName();

    if (
      name === CONFIG.QUOTE_SHEET ||
      name === CONFIG.CUSTOMER_QUOTE_SHEET
    ) {
      sheet.showSheet();
    } else {
      sheet.hideSheet();
    }
  });

  SpreadsheetApp.flush();

  return copiedFile;
}


/***************************************************************
 * CREATE CUSTOMER QUOTE PDF
 ***************************************************************/
function createCustomerQuotePDF(
  customerQuoteSheet,
  folderId,
  customer,
  quoteNumber
) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const spreadsheetId = ss.getId();
  const sheetId = customerQuoteSheet.getSheetId();

  const safeCustomer = customer
    .replace(/[\\\/:*?"<>|]/g, '')
    .trim();

  const fileName =
    safeCustomer +
    ' - Quote ' +
    quoteNumber +
    '.pdf';

  const url =
    'https://docs.google.com/spreadsheets/d/' +
    spreadsheetId +
    '/export?' +
    'format=pdf' +
    '&size=letter' +
    '&portrait=true' +
    '&fitw=true' +
    '&sheetnames=false' +
    '&printtitle=false' +
    '&pagenumbers=false' +
    '&gridlines=false' +
    '&fzr=false' +
    '&gid=' +
    sheetId;

  const token = ScriptApp.getOAuthToken();

  const response = UrlFetchApp.fetch(url, {
    headers: {
      Authorization: 'Bearer ' + token
    }
  });

  const blob = response
    .getBlob()
    .setName(fileName);

  const folder = DriveApp.getFolderById(folderId);

  return folder.createFile(blob);
}


/***************************************************************
 * GET BASE QUOTE NUMBER
 ***************************************************************/
function getBaseQuoteNumber(quoteNumber) {
  const value = String(quoteNumber).trim();
  const parts = value.split('-');

  // New format:
  // 25-26-0001
  // 25-26-0001-2
  if (parts.length >= 3) {
    return parts[0] + '-' + parts[1] + '-' + parts[2];
  }

  // Keeps compatibility with old quote numbers
  return parts[0].trim();
}



/***************************************************************
 * FIND NEXT REVISION
 ***************************************************************/
function getNextRevisionNumber(baseQuoteNumber) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let highestRevision = 0;

  [CONFIG.SALES_ARCHIVE, CONFIG.SERVICE_ARCHIVE].forEach(
    function(sheetName) {
      const sheet = ss.getSheetByName(sheetName);

      if (!sheet || sheet.getLastRow() < 2) return;

      const values = sheet
        .getRange(2, 2, sheet.getLastRow() - 1, 1)
        .getDisplayValues();

      values.forEach(function(row) {
        const savedQuote = String(row[0]).trim();

        if (!savedQuote) return;

        const savedBase = getBaseQuoteNumber(savedQuote);

        if (savedBase !== baseQuoteNumber) return;

        let revision = 1;

        const parts = savedQuote.split('-');

if (parts.length >= 4) {
  revision = parseInt(parts[3], 10);

  if (isNaN(revision)) revision = 1;
}

        if (revision > highestRevision) {
          highestRevision = revision;
        }
      });
    }
  );

  if (highestRevision === 0) {
    return 1;
  }

  return highestRevision + 1;
}


/***************************************************************
 * CLEAR QUOTE FOR NEXT CUSTOMER
 *
 * Does NOT clear formulas.
 ***************************************************************/
function clearQuote() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG.QUOTE_SHEET);

  const ui = SpreadsheetApp.getUi();

  const response = ui.alert(
    'Clear Quote',
    'Clear the current quote and start a new one?',
    ui.ButtonSet.YES_NO
  );

  if (response !== ui.Button.YES) return;

  // Top section
  sheet.getRange(CONFIG.QUOTE_NUMBER_CELL).clearContent();
  sheet.getRange(CONFIG.DATE_CELL).clearContent();

  sheet.getRange('E6').clearContent();
  sheet.getRange('G4').setValue('Draft');
sheet.getRange('G5').clearContent();
sheet.getRange('G6').clearContent();

  sheet.getRange(CONFIG.CUSTOMER_CELL).clearContent();
  sheet.getRange(CONFIG.ATTENTION_CELL).clearContent();
  sheet.getRange(CONFIG.PHONE_CELL).clearContent();
  sheet.getRange(CONFIG.EMAIL_CELL).clearContent();

  const rowCount =
    CONFIG.ITEM_END_ROW -
    CONFIG.ITEM_START_ROW +
    1;

  // A:F = Qty, Item, Part Number, Category, Customer Cost, Our Cost
  sheet
    .getRange(
      CONFIG.ITEM_START_ROW,
      1,
      rowCount,
      6
    )
    .clearContent();

  // H = Notes
  sheet
    .getRange(
      CONFIG.ITEM_START_ROW,
      8,
      rowCount,
      1
    )
    .clearContent();

  // G stays untouched because it contains Line Cost formulas

  SpreadsheetApp.flush();

  ui.alert('Quote cleared.');
}
