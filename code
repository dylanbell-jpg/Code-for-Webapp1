    const data = db
      .getRange(2, 1, lastRow - 1, 4)
      .getDisplayValues();

    for (let i = 0; i < data.length; i++) {
      const dbCustomer =
        String(data[i][0] || '').trim().toLowerCase();

      const dbAttention =
        String(data[i][1] || '').trim().toLowerCase();

      const sameCustomer =
        dbCustomer === cleanCustomer.toLowerCase();

      const sameContact =
        dbAttention === cleanAttention.toLowerCase();

      if (sameCustomer && sameContact) {
        existingRow = i + 2;
        break;
      }
    }
  }

  const rowData = [[
    cleanCustomer,
    cleanAttention,
    cleanPhone,
    cleanEmail,
    new Date()
  ]];

  if (existingRow) {
    // Same company + same contact:
    // update phone/email/date instead of duplicating.
    db
      .getRange(existingRow, 1, 1, 5)
      .setValues(rowData);
  } else {
    // New company OR different contact at same company:
    // create a new customer/contact row.
    db
      .getRange(db.getLastRow() + 1, 1, 1, 5)
      .setValues(rowData);
  }
}
function saveQuoteItemsToDatabase(quoteSheet) {
  const rowCount =
    CONFIG.ITEM_END_ROW -
    CONFIG.ITEM_START_ROW +
    1;

  const rows = quoteSheet
    .getRange(
      CONFIG.ITEM_START_ROW,
      1,
      rowCount,
      8
    )
    .getValues();

  rows.forEach(function(row, index) {
    const item = String(row[1] || '').trim();
    const partNumber = String(row[2] || '').trim();
    const category = String(row[3] || '').trim();
    const customerCost = row[4];
    const ourCost = row[5];

    if (!item) return;

    if (!category) {
      throw new Error(
        'Select a Category for item "' +
        item +
        '" on row ' +
        (CONFIG.ITEM_START_ROW + index) +
        '.'
      );
    }

    saveItemToDatabase(
      item,
      partNumber,
      customerCost,
      ourCost,
      category
    );
  });

  sortItemDatabaseByCategory();
}


function sortItemDatabaseByCategory() {
  const masterSS = SpreadsheetApp.openById(
    CONFIG.MASTER_SPREADSHEET_ID
  );

  const db = masterSS.getSheetByName('Item Database');
  const lists = masterSS.getSheetByName('Lists');

  if (!db || !lists) return;

  const lastDbRow = db.getLastRow();

  if (lastDbRow < 5) return;

  const lastListRow = lists.getLastRow();

  const categories = lists
    .getRange(2, 12, lastListRow - 1, 1)
    .getDisplayValues()
    .flat()
    .map(function(value) {
      return String(value).trim();
    })
    .filter(function(value) {
      return value !== '';
    });

  const categoryOrder = {};

  categories.forEach(function(category, index) {
    categoryOrder[category.toLowerCase()] = index;
  });

  const range = db.getRange(
    4,
    1,
    lastDbRow - 3,
    5
  );

  const values = range.getValues();

  values.sort(function(a, b) {
    const categoryA =
      String(a[4] || '').trim().toLowerCase();

    const categoryB =
      String(b[4] || '').trim().toLowerCase();

    const orderA =
      categoryOrder[categoryA] !== undefined
        ? categoryOrder[categoryA]
        : 9999;

    const orderB =
      categoryOrder[categoryB] !== undefined
        ? categoryOrder[categoryB]
        : 9999;

    if (orderA !== orderB) {
      return orderA - orderB;
    }

    return String(a[0] || '')
      .localeCompare(String(b[0] || ''));
  });

  range.setValues(values);
}
function getSalespersonEditableQuoteFolder(preparedBy) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const lists = ss.getSheetByName(CONFIG.LISTS_SHEET);

  if (!lists) return null;

  const lastRow = lists.getLastRow();

  if (lastRow < 2) return null;

  const data = lists
    .getRange(2, 3, lastRow - 1, 6)
    .getDisplayValues();

  for (let i = 0; i < data.length; i++) {
    const salesperson = String(data[i][0]).trim();
    const editableFolderId = String(data[i][5]).trim();

    if (
      salesperson.toLowerCase() ===
      preparedBy.toLowerCase()
    ) {
      return editableFolderId;
    }
  }

  return null;
}
function onEdit(e) {
  if (!e) return;

  const sheet = e.range.getSheet();

  if (sheet.getName() !== 'Archive Search') return;

  // J2 checkbox
  if (e.range.getA1Notation() !== 'J2') return;

  if (e.value !== 'TRUE') return;

  try {
    createRevisionFromArchiveSearch();
  } catch (err) {
    SpreadsheetApp.getUi().alert(
      'Could not create revision:\n\n' + err.message
    );
  } finally {
    sheet.getRange('J2').setValue(false);
  }
}
function createRevisionFromArchiveSearch() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const searchSheet = ss.getSheetByName('Archive Search');
  const quoteSheet = ss.getSheetByName(CONFIG.QUOTE_SHEET);

  if (!searchSheet || !quoteSheet) {
    throw new Error('Archive Search or Quote sheet was not found.');
  }

  const selectedQuoteNumber = String(
    searchSheet.getRange('H2').getDisplayValue()
  ).trim();

  if (!selectedQuoteNumber) {
    throw new Error(
      'Select a quote number in Revision Quote # first.'
    );
  }

  const register = ss.getSheetByName('Quote Register');

  let customer = '';
  let preparedBy = '';
  let editableUrl = '';

  if (register && register.getLastRow() >= 2) {
    const rows = register
      .getRange(
        2,
        1,
        register.getLastRow() - 1,
        16
      )
      .getDisplayValues();

    for (let i = 0; i < rows.length; i++) {
      if (
        String(rows[i][3]).trim() ===
        selectedQuoteNumber
      ) {
        customer = String(rows[i][1]).trim();
        preparedBy = String(rows[i][5]).trim();
        editableUrl = String(rows[i][13]).trim();
        break;
      }
    }
  }

  // Fallback to local quote archives
  if (!customer) {
    const archiveNames = [
      CONFIG.SALES_ARCHIVE,
      CONFIG.SERVICE_ARCHIVE
    ];

    for (let a = 0; a < archiveNames.length; a++) {
      const archive = ss.getSheetByName(archiveNames[a]);

      if (!archive || archive.getLastRow() < 2) continue;

      const rows = archive
        .getRange(
          2,
          1,
          archive.getLastRow() - 1,
          9
        )
        .getDisplayValues();

      for (let i = 0; i < rows.length; i++) {
        if (
          String(rows[i][1]).trim() ===
          selectedQuoteNumber
        ) {
          customer = String(rows[i][0]).trim();
          preparedBy = String(rows[i][3]).trim();
          break;
        }
      }

      if (customer) break;
    }
  }

  if (!customer) {
    throw new Error(
      'Quote ' +
      selectedQuoteNumber +
      ' was not found.'
    );
  }

  let sourceSpreadsheet = null;

  // Use stored editable link when available
  if (editableUrl) {
    const match = editableUrl.match(
      /\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/
    );

    if (match) {
      sourceSpreadsheet =
        SpreadsheetApp.openById(match[1]);
    }
  }

  // Fallback: find editable copy in salesperson folder
  if (!sourceSpreadsheet) {
    const editableFolderId =
      getSalespersonEditableQuoteFolder(preparedBy);

    if (!editableFolderId) {
      throw new Error(
        'Editable Quotes folder was not found for ' +
        preparedBy +
        '.'
      );
    }

    const folder =
      DriveApp.getFolderById(editableFolderId);

    const expectedName =
      customer +
      ' - Quote ' +
      selectedQuoteNumber +
      ' - EDITABLE';

    const files =
      folder.getFilesByName(expectedName);

    if (!files.hasNext()) {
      throw new Error(
        'Editable quote file was not found for ' +
        selectedQuoteNumber +
        '.'
      );
    }

    sourceSpreadsheet =
      SpreadsheetApp.openById(
        files.next().getId()
      );
  }

  const sourceQuote =
    sourceSpreadsheet.getSheetByName(
      CONFIG.QUOTE_SHEET
    );

  if (!sourceQuote) {
    throw new Error(
      'Quote tab was not found in the editable copy.'
    );
  }

  // Copy customer information
  quoteSheet
    .getRange(CONFIG.CUSTOMER_CELL)
    .setValue(
      sourceQuote
        .getRange(CONFIG.CUSTOMER_CELL)
        .getValue()
    );

  quoteSheet
    .getRange(CONFIG.ATTENTION_CELL)
    .setValue(
      sourceQuote
        .getRange(CONFIG.ATTENTION_CELL)
        .getValue()
    );

  quoteSheet
    .getRange(CONFIG.PHONE_CELL)
    .setValue(
      sourceQuote
        .getRange(CONFIG.PHONE_CELL)
        .getValue()
    );

  quoteSheet
    .getRange(CONFIG.EMAIL_CELL)
    .setValue(
      sourceQuote
        .getRange(CONFIG.EMAIL_CELL)
        .getValue()
    );

  quoteSheet
    .getRange(CONFIG.QUOTE_TYPE_CELL)
    .setValue(
      sourceQuote
        .getRange(CONFIG.QUOTE_TYPE_CELL)
        .getValue()
    );

  // Copy PO number
  quoteSheet
    .getRange('E6')
    .setValue(
      sourceQuote
        .getRange('E6')
        .getValue()
    );

  // Copy quote items A:H
  const rowCount =
    CONFIG.ITEM_END_ROW -
    CONFIG.ITEM_START_ROW +
    1;

  const sourceItems = sourceQuote
    .getRange(
      CONFIG.ITEM_START_ROW,
      1,
      rowCount,
      8
    )
    .getValues();

  quoteSheet
    .getRange(
      CONFIG.ITEM_START_ROW,
      1,
      rowCount,
      8
    )
    .setValues(sourceItems);

  // Set base quote number so saveQuote creates next revision
  const baseQuoteNumber =
    getBaseQuoteNumber(selectedQuoteNumber);

  quoteSheet
    .getRange(CONFIG.QUOTE_NUMBER_CELL)
    .setValue(baseQuoteNumber);

  // New revision gets today's date
  quoteSheet
    .getRange(CONFIG.DATE_CELL)
    .setValue(new Date());

  SpreadsheetApp.flush();

  ss.setActiveSheet(quoteSheet);

  SpreadsheetApp.getUi().alert(
    'Quote loaded for revision.\n\n' +
    'Original Quote: ' +
    selectedQuoteNumber +
    '\nNext save will create the next revision.'
  );
}
function saveQuoteToRegister(
  quoteSheet,
  finalQuoteNumber,
  quoteDate,
  customer,
  attention,
  preparedBy,
  quoteType,
  total,
  revision,
  pdfUrl
) {
  const masterSS = SpreadsheetApp.openById(
    CONFIG.MASTER_SPREADSHEET_ID
  );

  const register = masterSS.getSheetByName('Quote Register');

  if (!register) {
    throw new Error('Quote Register was not found in Dylan Master.');
  }

  const status =
    String(quoteSheet.getRange('G4').getDisplayValue()).trim() ||
    'Draft';

  const followUpDate =
    quoteSheet.getRange('G5').getValue();

  const notes =
    String(quoteSheet.getRange('G6').getDisplayValue()).trim();

  const rowCount =
    CONFIG.ITEM_END_ROW -
    CONFIG.ITEM_START_ROW +
    1;

  const itemRows = quoteSheet
    .getRange(
      CONFIG.ITEM_START_ROW,
      2,
      rowCount,
      2
    )
    .getDisplayValues();

  const itemSummary = itemRows
    .filter(function(row) {
      return row[0] || row[1];
    })
    .map(function(row) {
      const item = String(row[0] || '').trim();
      const part = String(row[1] || '').trim();

      if (item && part) {
        return item + ' (' + part + ')';
      }

      return item || part;
    })
    .join(', ');

  const quoteId = Utilities.getUuid();

  const nextRow = register.getLastRow() + 1;

  register.getRange(nextRow, 1, 1, 16).setValues([[
    quoteId,
    customer,
    attention,
    finalQuoteNumber,
    quoteDate,
    preparedBy,
    quoteType,
    total,
    revision,
    status,
    followUpDate || '',
    new Date(),
    pdfUrl || '',
    '',
    notes,
    itemSummary
  ]]);

  register
    .getRange(nextRow, 5)
    .setNumberFormat('m/d/yyyy');

  register
    .getRange(nextRow, 8)
    .setNumberFormat('$#,##0.00');

  register
    .getRange(nextRow, 11)
    .setNumberFormat('m/d/yyyy');

  register
    .getRange(nextRow, 12)
    .setNumberFormat('m/d/yyyy h:mm AM/PM');
}
function autoFillCustomer(quoteSheet) {
  const customer = String(
    quoteSheet
      .getRange(CONFIG.CUSTOMER_CELL)
      .getDisplayValue()
  ).trim();

  const attentionCell =
    quoteSheet.getRange(CONFIG.ATTENTION_CELL);

  const phoneCell =
    quoteSheet.getRange(CONFIG.PHONE_CELL);

  const emailCell =
    quoteSheet.getRange(CONFIG.EMAIL_CELL);

  attentionCell.clearDataValidations();

  if (!customer) {
    attentionCell.clearContent();
    phoneCell.clearContent();
    emailCell.clearContent();
    return;
  }

  const masterSS = SpreadsheetApp.openById(
    CONFIG.MASTER_SPREADSHEET_ID
  );

  const db = masterSS.getSheetByName(
    'Customer Database'
  );

  if (!db || db.getLastRow() < 2) return;

  const rows = db
    .getRange(
      2,
      1,
      db.getLastRow() - 1,
      4
    )
    .getDisplayValues();

  const matches = rows.filter(function(row) {
    return (
      String(row[0]).trim().toLowerCase() ===
      customer.toLowerCase()
    );
  });

  if (matches.length === 0) {
    attentionCell.clearContent();
    phoneCell.clearContent();
    emailCell.clearContent();
    return;
  }

  const contacts = matches
    .map(function(row) {
      return String(row[1] || '').trim();
    })
    .filter(function(value) {
      return value !== '';
    });

  const uniqueContacts =
    [...new Set(contacts)];

  if (uniqueContacts.length > 0) {
    const rule =
      SpreadsheetApp
        .newDataValidation()
        .requireValueInList(
          uniqueContacts,
          true
        )
        .setAllowInvalid(true)
        .build();

    attentionCell.setDataValidation(rule);
  }

  const firstMatch = matches[0];

  attentionCell.setValue(
    firstMatch[1] || ''
  );

  phoneCell.setValue(
    firstMatch[2] || ''
  );

  emailCell.setValue(
    firstMatch[3] || ''
  );
}
